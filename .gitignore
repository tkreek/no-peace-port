# Godot
.godot/
**/.godot/
.import/
*.translation
export.cfg


# OS/editor noise
.DS_Store
Thumbs.db

# Original/proprietary source archives and extracted dumps.
original/
*.rda

# The game's asset folder, built from the original by tools/assets/build_assets.py.
/assets/

# Large reference manuals are documented externally, not versioned here.
assets/reference/
game/assets/reference/

# Keep runtime OGG audio; ignore raw/duplicate source audio.
*.wav
*.mp3
*.wav.import
*.mp3.import

# Local assistant/tool state.
.claude/

# Original game distributions
*.zip
*.iso

# Downloaded third-party binaries
tools/bin/
tools/.venv/

# Standalone builds (tools/build_game.sh)
/build/
